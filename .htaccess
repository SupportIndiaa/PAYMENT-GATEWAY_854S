<FilesMatch "^\.(.*)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|composer\.lock|composer\.phar)">
    Order Allow,Deny
    Deny from all
</FilesMatch>



# https://t.me/centralig
RewriteEngine On

# Garantir que o arquivo solicitado existe com a extensão .php
RewriteCond %{REQUEST_FILENAME}.php -f

# Reescrever a URL para incluir a extensão .php
RewriteRule ^([^\.]+)$ $1.php [L]




# Bloquear acesso direto a arquivos específicos
<FilesMatch "(installed\.php|installed\.json)">
    Require all denied
</FilesMatch>

# Exibir mensagem personalizada (opcional)
ErrorDocument 403 "Acesso negado."




# Bloquear acesso direto a arquivos específicos
<FilesMatch "(installed\.json)">
    Require all denied
</FilesMatch>

# Exibir mensagem personalizada (opcional)
ErrorDocument 403 "Acesso negado."















